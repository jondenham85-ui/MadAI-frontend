# Browser requests use same-origin API paths.
NEXT_PUBLIC_API_URL=/api/backend

# Public Supabase project settings. These are embedded in the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Backend execution runs in the existing Supabase project.
# Service-role, Meta, OpenAI and Stripe secrets belong only in server-side secret stores.
# API destinations are fixed in next.config.js and cannot use a legacy override.
